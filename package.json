{
  "name": "kyrolll",
  "productName": "KYROlll MANAGER",
  "version": "1.0.0",
  "description": "KYROlll MANAGER — installer, updater and plugin manager for KYROlll audio plugins.",
  "private": true,
  "license": "UNLICENSED",
  "author": "KYROlll",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "python3 scripts/build-icon.py",
    "plugin:package": "node scripts/make-demo-archives.js",
    "demo:archive": "npm run plugin:package",
    "smoke": "electron scripts/smoke-install.js",
    "smoke:update": "electron scripts/smoke-update.js",
    "smoke:ui": "electron scripts/smoke-ui.js",
    "verify:build": "node scripts/verify-build-config.js",
    "test": "npm run verify:build && npm run smoke && npm run smoke:update",
    "dist": "npm run dist:mac",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:intel": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win",
    "dist:all": "npm run dist:mac && npm run dist:win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.kyrolll.KYROlll",
    "productName": "KYROlll MANAGER",
    "copyright": "Copyright © 2026 KYROlll",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "artifactName": "KYROlll-MANAGER-${version}-${arch}.${ext}",
      "darkModeSupport": true
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KYROlll-MANAGER-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KYROlll MANAGER"
    }
  }
}
